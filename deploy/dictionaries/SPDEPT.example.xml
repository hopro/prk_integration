<?xml version="1.0" encoding="windows-1251"?>
<!--
  ШАБЛОН справочника подразделений ИАС-4.
  Положите рядом с docker-compose.yml как SPDEPT.xml (или SPDEPT.zip).

  Это единственный источник кодов, которые ИАС-4 принимает в поле podr.
  Список участков ЕЦП для этой цели не подходит: там своя нумерация,
  и все коды с суффиксом _ГРП (40 из 107 участков ГП № 4) ИАС-4 отвергает
  ошибкой 501 «Участок/пункт отделение МО отсутствует в справочнике».

  Распознаются атрибуты:
    код   — CODE, PODR, PODR_CODE, ID, KOD
    имя   — NAME, PODRNAME, TITLE
    МО    — MO, MO_CODE, CODE_MO

  Подойдёт и CSV с теми же заголовками, разделитель «;» или «,».
-->
<ROOT>
  <REC PODR="20100" NAME="Терапевтический участок 1" MO="893"/>
  <REC PODR="31400" NAME="Терапевтический участок 14" MO="893"/>
</ROOT>
