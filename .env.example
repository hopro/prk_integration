# ============================================================================
# Настройки развёртывания.
#
# Порядок действий:
#   cp .env.example .env
#   отредактировать .env — четыре строки с пометкой ОБЯЗАТЕЛЬНО
#   положить выгрузки справочников в ./tfoms
#   docker compose up -d --build
#
# Этот файл при обновлении не перезаписывается: в .gitignore он не входит,
# поэтому `git pull` его не тронет. Все ваши настройки сохранятся.
# ============================================================================

# --------------------------------------------------------------- порт и время
# Порт, на котором система открывается в браузере: http://<сервер>:<APP_PORT>
APP_PORT=3001

# Часовой пояс сервера. Влияет на отметки времени в истории прикреплений.
TZ=Asia/Yekaterinburg


# ======================================================== ОБЯЗАТЕЛЬНО К ЗАПОЛНЕНИЮ
# Четыре значения ниже обязательны: без них контейнеры не запустятся.
# Подойдёт любой набор букв и цифр. Сгенерировать можно одной командой:
#
#   openssl rand -base64 24
#
# ВАЖНО: GATEWAY_DB_PASSWORD задаётся только при первом запуске — он сохраняется
# в томе Postgres. Если поменять его в .env позже, шлюз перестанет
# подниматься с «password authentication failed». См. deploy/ИНСТРУКЦИЯ.md.

# Пароль базы данных шлюза (Postgres, внутренний том).
GATEWAY_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Ключ подписи сессий шлюза. Любая длинная строка.
JWT_SECRET_KEY=CHANGE_ME_RANDOM_STRING

# Учётная запись администратора самого шлюза: логин и пароль, по которым
# backend ходит в шлюз. Учётные данные ЕЦП сюда НЕ входят — их вводят
# в интерфейсе, шестерёнка → «Учётные данные ЕЦП».
GATEWAY_LOGIN=admin
GATEWAY_PASSWORD=CHANGE_ME_ADMIN_PASSWORD


# ============================================================================
# Дальше менять обычно не нужно. Значения ниже — рабочие умолчания.
# ============================================================================

# ------------------------------------------------------------ каталог данных
# Настройки, справочники и история прикреплений лежат в SQLite здесь.
# При переносе на другой сервер скопируйте этот каталог целиком.
# Не указывайте путь внутрь ./backend — он попадёт в образ при сборке.
DATA_DIR=./data


# --------------------------------------------------------------- база шлюза
# Имя БД и пользователя в Postgres шлюза. Меняйте только если переносите
# существующую базу под новыми именами.
GATEWAY_DB_NAME=mis_gateway
GATEWAY_DB_USER=mis_gateway

# Сколько часов живёт сессия в интерфейсе. По истечении нужно войти заново.
JWT_ACCESS_EXPIRE_MINUTES=480


# ---------------------------------------------------------- адреса сервисов
# Значения по умолчанию. Меняются в интерфейсе:
# шестерёнка → «Адреса сервисов». Поэтому править здесь нужно только
# при первом развёртывании.

# Прикрепление застрахованных лиц (SOAP, ИАС-4 ТФОМС).
# Для проверки на тестовом контуре замените LoadPrk на LoadPrkTest.
SOAP_URL=http://10.0.100.5/IASWeb/LoadPrk/LoadPrk.asmx

# Проверка страховой принадлежности (SOAP, ИАС-4 ТФОМС).
SOAP_CHECK_URL=http://10.0.100.5/IASWeb/InsCheck/InsCheck.asmx

# Адрес ЕЦП. Меняется в интерфейсе.
MIS_BASE_URL=https://ecp.mis66.ru

# Таймаут обращения к ЕЦП, секунд.
MIS_REQUEST_TIMEOUT=30

# Сообщать ли билет об ошибке в интерфейс. Не нужно включать на бою.
APP_DEBUG=false


# ------------------------------------------------------------ справочники
# Файлы выгрузок кладутся в ./tfoms:
#   SPSMO.zip           страховые компании
#   SPMO.zip            медицинские организации
#   SPDEPT.xml          подразделения ИАС-4 — ОБЯЗАТЕЛЕН, это коды для поля podr
#
# Внешняя СУБД не используется: справочники хранятся локально в
# ${DATA_DIR}/dictionaries.db и обновляются из этих файлов.

# Кодировка XML-выгрузок ТФОМС.
TFOMS_ENCODING=cp1251


# ---------------------------------------------------------------- шлюз
# Порт шлюза внутри сети compose. Обычно менять не нужно.
# Если в системе несколько экземпляров на одном сервере — укажите свой,
# и тогда же продублируйте его в docker-compose.yml для сервиса gateway.
GATEWAY_PORT=8010
