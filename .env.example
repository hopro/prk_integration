# ===========================================================================
# Настройки развёртывания. Скопируйте файл как .env и заполните значения.
#   cp .env.example .env
# Перед запуском проверьте, что docker compose видит переменные:
#   docker compose config
# ===========================================================================

# ------------------------------------------------------------------ порт
# Порт, на котором заказчик открывает систему в браузере.
APP_PORT=3001
TZ=Asia/Yekaterinburg

# ------------------------------------------------------- пароли (ОБЯЗАТЕЛЬНО)
# Свои значения. Их нельзя оставлять как в примере.
GATEWAY_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_RANDOM_STRING
# Учётная запись шлюза: логин и пароль, по которым backend ходит в шлюз.
# Учётные данные ЕЦП ей НЕ назначаются — их вводят в интерфейсе.
GATEWAY_LOGIN=CHANGE_ME_GATEWAY_LOGIN
GATEWAY_PASSWORD=CHANGE_ME_GATEWAY_PASSWORD

# ------------------------------------------------------------------- данные
# Каталог для SQLite: настройки, справочники, история прикреплений.
# Здесь и держится всё состояние системы — при переезде копируйте этот каталог.
# Не задавайте путь внутрь ./backend: он попадёт в образ при сборке.
DATA_DIR=./data

# -------------------------------------------------------------- база шлюза
GATEWAY_DB_NAME=mis_gateway
GATEWAY_DB_USER=mis_gateway
JWT_ACCESS_EXPIRE_MINUTES=480

# ------------------------------------------------------------ адреса сервисов
# Значения по умолчанию; далее меняются в интерфейсе:
# шестерёнка → «Адреса сервисов».
SOAP_URL=http://10.0.100.5/IASWeb/LoadPrk/LoadPrk.asmx
SOAP_CHECK_URL=http://10.0.100.5/IASWeb/InsCheck/InsCheck.asmx
MIS_BASE_URL=https://ecp.mis66.ru
MIS_REQUEST_TIMEOUT=30

# -------------------------------------------------------- справочники ТФОМС
# XML-выгрузки кладутся в ./tfoms. SOAPAction протоколом ИАС-4 задан жёстко.
TFOMS_ENCODING=cp1251